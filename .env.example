# 数据库配置
DATABASE_URL=mysql+aiomysql://username:password@host/database

# 邮箱配置
EMAIL_FROM=your_email@example.com
SMTP_SERVER=smtp.example.com
SMTP_PORT=465
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_email_password_or_app_password

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# 开发模式（仅本地/测试环境启用）
DEBUG=false
DEBUG_MASTER_PASSWORD=DEBUG_PASS_123
DEBUG_SKIP_PASSWORD_CHECK=false
WX_APP_ID=your_wechat_app_id
WX_APP_SECRET=your_wechat_app_secret

# 短信/阿里云配置
ALI_ACCESS_KEY_ID=your_aliyun_ak
ALI_ACCESS_KEY_SECRET=your_aliyun_sk
SMS_TEMPLATE_CODE=your_template_code
SMS_SIGN_NAME=your_sign_name
