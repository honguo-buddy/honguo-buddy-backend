    """测试 Pydantic 输入参数层对边界、脏数据的原生拦截分支"""
    # 路径 1：测试正常输入（Happy Path）
    valid_data = {"title": "合规委托", "price": 10.5, "direction": "SELL"}
    assert PostCreateSchema.model_validate(valid_data).price == 10.5

    # 路径 2：测试恶意负数价格，验证分支拦截（Failure Path）
    with pytest.raises(ValidationError) as exc_info:
        PostCreateSchema.model_validate({"title": "白嫖跑腿", "price": -50.0, "direction": "SELL"})
    assert "price" in str(exc_info.value)
B. 集成测试层示范 (tests/integration/api/test_post_api.py)Python@pytest.mark.asyncio
async def test_post_update_permissions_matrix(client, db_session, test_user, test_hacker, fake_redis):
    """【全出口测试】逆向轰击发帖更新接口的所有权限与安全断路器分支"""
    # 前置数据准备：生成属于 test_user (用户A) 的帖子
    post = Post(post_id=888, publisher_id=test_user.user_id, title="原版委托", status="OPEN")
    db_session.add(post)
    await db_session.flush()

    # 出口分支 1：黑客（用户B）企图横向越权篡改用户A的帖子
    hacker_token = "jwt_hacker_token_xyz"
    await fake_redis.set(f"token:{hacker_token}", str(test_hacker.user_id))
    
    resp = await client.patch(
        f"/posts/{post.post_id}",
        headers={"Authorization": f"Bearer {hacker_token}"},
        json={"title": "我是黑客，我来篡改你"}
    )
    body = resp.json()
    # 断言：必须精准触发统一拦截器抛出的 102 越权 code，且结构完好
    assert body["code"] == 102
    assert body["message"]["error"] == "权限不足"
    assert "msg" in body["message"]

    # 出口分支 2：不带 Token 匿名冲撞接口
    resp_anon = await client.patch(f"/posts/{post.post_id}", json={"title": "匿名冲撞"})
    body_anon = resp_anon.json()
    assert body_anon["code"] == 105  # 期望未登录拦截
